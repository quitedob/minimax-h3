{
  "prompt": {
    "unet": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "minimax_h3_fl2va_pruned_fp8_scaled.safetensors",
        "weight_dtype": "default"
      }
    },
    "clip": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
        "type": "minimax",
        "device": "default"
      }
    },
    "vae_video": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "minimax_h3_video_vae_fp16.safetensors"
      }
    },
    "vae_audio": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
      }
    },
    "cond": {
      "class_type": "MiniMaxH3ImageToVideo",
      "inputs": {
        "clip": [
          "clip",
          0
        ],
        "vae": [
          "vae_video",
          0
        ],
        "prompt": "A cinematic shot of a golden retriever puppy running through a sunlit park at golden hour, grass blowing in the wind, camera tracking smoothly, warm natural lighting, shallow depth of field, soft ambient nature sounds",
        "width": 864,
        "height": 480,
        "length": 124
      }
    },
    "solattn": {
      "class_type": "SolAttnPatch",
      "inputs": {
        "model": [
          "unet",
          0
        ],
        "tau": 1.3,
        "start_percent": 0.2,
        "end_percent": 0.9,
        "min_tokens": 4096,
        "int8_qk": true,
        "sink_conditioning": "exact_kv_and_rows",
        "morton": true,
        "morton_curve": "2d_frame",
        "verbose": false,
        "use_tma": false
      }
    },
    "easycache": {
      "class_type": "EasyCache",
      "inputs": {
        "model": [
          "solattn",
          0
        ],
        "reuse_threshold": 0.3,
        "start_percent": 0.2,
        "end_percent": 0.9,
        "verbose": false
      }
    },
    "noise": {
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": 42
      }
    },
    "guider": {
      "class_type": "BasicGuider",
      "inputs": {
        "model": [
          "easycache",
          0
        ],
        "conditioning": [
          "cond",
          0
        ]
      }
    },
    "sampler_select": {
      "class_type": "KSamplerSelect",
      "inputs": {
        "sampler_name": "res_multistep"
      }
    },
    "sigmas": {
      "class_type": "BasicScheduler",
      "inputs": {
        "model": [
          "unet",
          0
        ],
        "scheduler": "simple",
        "steps": 20,
        "denoise": 1.0
      }
    },
    "sample": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": [
          "noise",
          0
        ],
        "guider": [
          "guider",
          0
        ],
        "sampler": [
          "sampler_select",
          0
        ],
        "sigmas": [
          "sigmas",
          0
        ],
        "latent_image": [
          "cond",
          1
        ]
      }
    },
    "save": {
      "class_type": "SaveVideo",
      "inputs": {
        "video": [
          "video",
          0
        ],
        "filename_prefix": "video/Cloud_H3_Sage3_SolAttn_EasyCache",
        "format": "auto",
        "codec": "auto"
      }
    },
    "decode_video": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "sample",
          0
        ],
        "vae": [
          "vae_video",
          0
        ]
      }
    },
    "decode_audio": {
      "class_type": "VAEDecodeAudio",
      "inputs": {
        "samples": [
          "sample",
          0
        ],
        "vae": [
          "vae_audio",
          0
        ]
      }
    },
    "video": {
      "class_type": "CreateVideo",
      "inputs": {
        "images": [
          "decode_video",
          0
        ],
        "fps": 24,
        "audio": [
          "decode_audio",
          0
        ]
      }
    }
  },
  "client_id": "cloud-h3-sage3-solattn-easycache"
}